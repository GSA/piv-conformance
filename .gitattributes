# https://help.github.com/articles/dealing-with-line-endings/
#
# These are explicitly windows files and should use crlf
*.bat           text eol=crlf
# Empty hexadecimal inputs are intentional final TSV fields (a trailing tab).
conformancelib/src/main/resources/standards/*.tsv whitespace=-blank-at-eol

# Script-generated inventory snapshots are available for inspection but collapsed
# by default in GitHub reviews; keep the maintained manifest and review notes visible.
standards/historical-cases.json linguist-generated
